# Gemini API キー
# https://aistudio.google.com/app/apikey から取得
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash

# Anthropic API キー（Claude Haiku用）
# https://console.anthropic.com/ から取得
ANTHROPIC_API_KEY=your_key_here

# 会話メモリ暗号化キー（32文字以上のランダム文字列を推奨）
# 未設定時は会話メモリが平文保存されます（開発用）
SAVE_DATA_SECRET_KEY=your_secret_here
